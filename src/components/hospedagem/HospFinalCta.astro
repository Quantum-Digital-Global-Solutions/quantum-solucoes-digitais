---
/**
 * 6. CTA FINAL — bloco de encerramento do ds2 (glass + luz violeta, título em 3D por palavra).
 * Usa o mecanismo de contato existente (CTA.href em src/data/site.ts).
 */
import Button from '../Button.astro';
import { finalCta as hospedagemCta } from '../../data/hospedagem';
import { CTA } from '../../data/site';

/** Textos do CTA final. Padrão: Hospedagem; a página de Saúde passa os seus. */
const { data: finalCta = hospedagemCta } = Astro.props;
---

<section class="section" id="contato" data-tone="0" aria-labelledby="contato-title">
  <div class="container">
    <div class="cta bg-grad rv">
      <span class="hair"></span>
      <span class="pill">{finalCta.pill}</span>
      <h2 class="h2" id="contato-title" data-split="3d">{finalCta.title}</h2>
      <p class="body">{finalCta.text}</p>
      <p class="highlight">{finalCta.highlight}</p>
      <div class="actions">
        <Button href={CTA.href} target="_blank" rel="noopener">{finalCta.cta}</Button>
      </div>
      <p class="area small"><span class="dot"></span>{finalCta.small}</p>
    </div>
  </div>
</section>

<style>
  section {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0), #000 64px);
    color: #fafafa;
  }
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5.5rem) 24px;
    border-radius: 24px;
    text-align: center;
    color: #fafafa;
    background: radial-gradient(900px 400px at 50% 50%, rgba(var(--amb-violet), 0.16), transparent), rgba(23, 23, 23, 0.6);
    box-shadow: inset 0 0 0 1px var(--ring);
  }
  .h2 {
    max-width: 20ch;
    margin: 22px auto 0;
  }
  .body {
    margin: 22px auto 0;
    max-width: 40rem;
    color: #e5e5e5;
  }
  .highlight {
    margin: 28px auto 0;
    max-width: 30ch;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
  }
  .actions {
    margin-top: 36px;
  }
  .area {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    color: #d4d4d4;
  }
  @media (max-width: 640px) {
    .cta {
      padding-inline: 20px;
    }
  }
</style>
