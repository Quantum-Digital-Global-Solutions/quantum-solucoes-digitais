---
/**
 * 5. JORNADA E OPERAÇÃO — ds2 · dobra clara.
 * À esquerda, o diagnóstico (gargalos diferentes); à direita, uma linha do tempo
 * vertical com os três momentos. O do meio — a decisão — inverte para dark.
 */
import { journey } from '../../data/hospedagem';
---

<section class="section" id="jornada" data-tone="1" aria-labelledby="jornada-title">
  <div class="container split">
    <div class="intro">
      <span class="pill ad rv">{journey.pill}</span>
      <h2 class="h2" id="jornada-title" data-split>{journey.title}</h2>
      <p class="lead rv" style="--d:.3s">{journey.lead}</p>
      <ul class="cases">
        {journey.cases.map((c, k) => <li class="rv" style={`--d:${0.36 + k * 0.08}s`}>{c}</li>)}
      </ul>
      <p class="back body-lg mut rv" style="--d:.6s">{journey.backstage}</p>
    </div>

    <div class="tl-wrap">
      <p class="tl-label rv">{journey.timelineLabel}</p>
      <ol class="tl">
        {
          journey.stages.map((s, k) => (
            <li class:list={['stage', 'rv', s.dark && 'is-dark']} style={`--d:${k * 0.1}s`}>
              <span class="node" aria-hidden="true"><i></i></span>
              <div class:list={['card-s', s.dark ? 's-glass bg-grad' : 's-light']}>
                <span class="hair"></span>
                <header>
                  <span class:list={['pill', s.dark ? '' : 'lt']}>{s.n}</span>
                  <h3 class="st">{s.title}</h3>
                </header>
                <ul class="lines">
                  {s.lines.map((l) => <li>{l}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .intro {
    position: sticky;
    top: 120px;
  }
  .intro .h2 {
    margin-top: 24px;
    font-size: clamp(2rem, 3.7vw, 3.125rem);
    text-wrap: balance;
  }
  .lead {
    margin-top: 28px;
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .cases {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }
  .cases li {
    position: relative;
    padding-left: 22px;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--n600);
  }
  .cases li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: currentColor;
  }
  .back {
    margin-top: 24px;
    max-width: 46ch;
  }

  .tl-label {
    margin-bottom: 20px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--n500);
  }
  .tl {
    position: relative;
    display: grid;
    gap: 16px;
    padding-left: 36px;
  }
  /* linha que liga os três momentos */
  .tl::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 24px;
    bottom: 24px;
    width: 1px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.1));
  }
  .stage {
    position: relative;
  }
  .node {
    position: absolute;
    left: -36px;
    top: 24px;
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--off);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
  }
  .node i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    transform: scale(0);
    transition: transform 0.7s var(--ease-emphasis) 0.35s;
  }
  .stage:global(.in) .node i {
    transform: scale(1);
  }
  .is-dark .node i {
    background: #7c3aed;
  }
  .card-s {
    position: relative;
    padding: 28px 30px 26px;
    border-radius: 20px;
    transition: transform 0.6s var(--ease-emphasis), box-shadow 0.5s;
  }
  .card-s:hover {
    transform: translateX(6px);
  }
  .card-s header {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .st {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .lines {
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
  }
  .lines li {
    position: relative;
    padding-left: 18px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--n600);
  }
  .lines li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  /* bastidores: superfície dark sólida (ds2 .panel.on) — o glass ficaria cinza sobre fundo claro */
  .is-dark .card-s {
    color: #fafafa;
    background: radial-gradient(520px 220px at 95% 120%, rgba(var(--amb-violet), 0.2), transparent), #0a0a0a;
    box-shadow: inset 0 0 0 1px var(--ring), 0 30px 60px -24px rgba(0, 0, 0, 0.45);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .is-dark .lines li {
    color: var(--n300);
  }

  @media (max-width: 1000px) {
    .split {
      grid-template-columns: 1fr;
    }
    .intro {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .tl {
      padding-left: 28px;
    }
    .node {
      left: -28px;
    }
    .tl::before {
      left: 7px;
    }
    .card-s {
      padding: 22px 20px;
    }
    .lines {
      grid-template-columns: 1fr;
    }
  }
</style>
