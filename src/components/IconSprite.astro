---
import { ICONS } from '../data/icons';
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  {
    Object.entries(ICONS).map(([id, paths]) => (
      <symbol
        id={`i-${id}`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={paths}
      />
    ))
  }
</svg>
