---
/**
 * HERO · Soluções para Saúde — derivado do ds3.html e da Hero da Home.
 * Composição própria: cartão de perfil profissional (decorativo) que mostra o que o paciente
 * precisa perceber — atuação clara, informações organizadas e próximo passo. Sem imagem de banco.
 * Tokens do ds3 isolados neste componente.
 */
import { hero } from '../../data/saude';
import { CTA, SITE } from '../../data/site';

const arrow = '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>';
const check = '<path d="M20 6 9 17l-5-5"/>';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow fu" style="--d:.1s">{hero.eyebrow}</p>
      <h1 id="hero-title" class="display">
        {
          hero.lines.map((l, k) => (
            <Fragment>
              <span class="ln"><span style={`--i:${k}`}>{l}</span></span>{' '}
            </Fragment>
          ))
        }
        {
          hero.accentLines.map((l, k) => (
            <Fragment>
              <span class:list={['ln', k === hero.accentLines.length - 1 && 'pb']}><span style={`--i:${hero.lines.length + k}`}><em class="it">{l}</em></span></span>{' '}
            </Fragment>
          ))
        }
      </h1>
      {hero.text.map((t, k) => <p class:list={['lead', 'fu', k > 0 && 'lead-2']} style={`--d:${0.4 + k * 0.1}s`}>{t}</p>)}
      <div class="hero-cta fu" style="--d:.65s">
        <a href={CTA.href} class="hbtn hbtn-primary hbtn-lg" target="_blank" rel="noopener">
          <span class="sheen"></span>{hero.cta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
        </a>
      </div>
      <p class="complement fu" style="--d:.75s"><span class="dot-s" aria-hidden="true"></span>{hero.complement}</p>
    </div>

    <!-- Composição visual (decorativa): perfil profissional + o que o paciente precisa perceber -->
    <div class="hv" aria-hidden="true">
      <div class="hv-panel"><span class="amb a1"></span><span class="amb a2"></span></div>
      <span class="hv-ghost"></span>
      <div class="hv-3d">
        <figure class="hv-img">
          <div class="bar"><i></i><i></i><i></i><span>presença profissional</span></div>
          <div class="ui">
            <div class="ui-main">
              <div class="who">
                <span class="av"></span>
                <span class="nm"><span class="sk h" style="width:70%"></span><span class="sk x" style="width:46%"></span></span>
              </div>
              <span class="sk x" style="width:88%;margin-top:14px"></span>
              <span class="sk x" style="width:72%"></span>
              <ul class="opts">
                {
                  hero.steps.map((o, k) => (
                    <li style={`--k:${k}`}>
                      <i />
                      <span>{o}</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
                    </li>
                  ))
                }
              </ul>
              <span class="cta-sk"></span>
            </div>
          </div>
        </figure>
      </div>
      <div class="note n1" style="--r:-4deg;--dl:0s">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg></i>
        <span><b>Transmitir confiança</b><small>Antes do contato</small></span>
      </div>
      <div class="note n2" style="--r:3deg;--dl:1.4s">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></i>
        <span><b>Facilitar o contato</b><small>Próximo passo claro</small></span>
      </div>
      <div class="hv-cap">
        <div>
          <p class="h3">Do primeiro contato ao próximo passo</p>
          <p class="cap-sm">{SITE.name}</p>
        </div>
        <span class="ibtn ibtn-d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} /></span>
      </div>
    </div>
  </div>

  <!-- Faixa em marquee (ds3) — pontos de contato citados no briefing -->
  <div class="band" aria-hidden="true">
    <div class="track" style="--dur:52s">
      {hero.band.map((c) => <span class="chip">{c}</span>)}
      {hero.band.map((c) => <span class="chip dup">{c}</span>)}
    </div>
  </div>
</section>

<style>
  /* =========================================================
     TOKENS ds3 — escopo exclusivo da Hero
     ========================================================= */
  .hero {
    --black: #080808;
    --off: #f2f2f2;
    --t-dark: #101010;
    --t-dark-2: #555;
    --t-light: #f5f5f5;
    --t-light-2: #b8b8b8;
    --b-dark: rgba(255, 255, 255, 0.08);
    --b-dark-s: rgba(255, 255, 255, 0.14);
    --glow-a: 59, 130, 246;
    --glow-b: 249, 115, 22;
    --glow-c: 168, 85, 247;
    --font: 'Instrument Sans', 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --fs-display: clamp(2rem, 3.6vw, 3.6rem);
    --fs-h3: clamp(1.25rem, 1.7vw, 1.6rem);
    --fs-body: clamp(1.05rem, 1.25vw, 1.25rem);
    --ease-std: cubic-bezier(0.2, 0.8, 0.2, 1);
    --ease-emph: cubic-bezier(0.16, 1, 0.3, 1);
    --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 40px rgba(0, 0, 0, 0.06);
    --shadow-dark: 0 28px 80px rgba(0, 0, 0, 0.3);

    position: relative;
    overflow: hidden;
    padding-top: clamp(8.5rem, 12vw, 11rem);
    background: var(--off);
    color: var(--t-dark);
    font-family: var(--font);
  }
  .wrap {
    width: min(100% - 48px, 1360px);
    margin-inline: auto;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  /* ---------- Tipografia (ds3) ---------- */
  .eyebrow {
    margin-bottom: 2rem;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #6b6b6b;
  }
  .display {
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.056em;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .ln > span {
    display: block;
  }
  .ln.pb {
    padding-bottom: 0.16em;
  }
  .it {
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    font-size: 1.08em;
    line-height: 1.05;
    padding-right: 0.06em;
  }
  .lead {
    margin-top: 2rem;
    max-width: 50ch;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--t-dark-2);
  }
  .lead-2 {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.1vw, 1.125rem);
  }
  .h3 {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  /* ---------- Botões (ds3) ---------- */
  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }
  .hbtn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding-inline: 28px;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.28s var(--ease-std), background 0.28s var(--ease-std), box-shadow 0.28s var(--ease-std);
  }
  .hbtn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }
  .hbtn svg {
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform 0.28s var(--ease-std);
  }
  .hbtn:hover svg {
    transform: translate(2px, -2px);
  }
  .hbtn-lg {
    height: 60px;
    padding-inline: 36px;
    font-size: 1rem;
  }
  .hbtn-primary {
    background: var(--black);
    color: #fff;
    border: 1px solid var(--black);
  }
  .hbtn-primary:hover {
    background: #202020;
  }
  .sheen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    z-index: -1;
    pointer-events: none;
  }
  .sheen::after {
    content: '';
    position: absolute;
    top: 0;
    left: -50%;
    width: 50%;
    height: 100%;
    background: rgba(255, 255, 255, 0.15);
    filter: blur(4px);
    transform: skewX(12deg);
    opacity: 0;
    transition: transform 0.7s, opacity 0.7s;
  }
  .hbtn:hover .sheen::after {
    transform: translateX(320%) skewX(12deg);
    opacity: 0.5;
  }
  .hbtn:focus-visible {
    outline: 2px solid var(--t-dark);
    outline-offset: 4px;
  }
  .complement {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #6b6b6b;
  }
  .dot-s {
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--black);
  }
  .ibtn {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--t-light);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--b-dark-s);
  }
  .ibtn svg {
    width: 18px;
    height: 18px;
  }

  /* ---------- Composição visual (ds3 .hv) ---------- */
  .hv {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 534 / 660;
  }
  .hv-panel {
    position: absolute;
    inset: 15% 0 0;
    border-radius: 56px;
    background: radial-gradient(120% 70% at 50% 0%, rgba(255, 255, 255, 0.05), transparent 60%), var(--black);
    overflow: hidden;
    box-shadow: var(--shadow-dark), inset 0 0 0 1px var(--b-dark);
  }
  .amb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
    animation: heroBreathe 9s ease-in-out infinite alternate;
  }
  .a1 {
    width: 60%;
    height: 45%;
    top: -10%;
    right: -15%;
    background: rgba(var(--glow-a), 0.22);
  }
  .a2 {
    width: 55%;
    height: 40%;
    bottom: 10%;
    left: -20%;
    background: rgba(var(--glow-b), 0.14);
    animation-delay: -4s;
  }
  .hv-3d {
    position: absolute;
    inset: 0;
    perspective: 1400px;
    z-index: 2;
  }
  .hv-ghost {
    position: absolute;
    top: 0;
    left: 12%;
    width: 76%;
    aspect-ratio: 16 / 11;
    border-radius: 16px;
    background: #141416;
    transform: rotate(-6deg);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 20px 50px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }
  .hv-img {
    position: absolute;
    top: 3%;
    left: 5%;
    width: 90%;
    border-radius: 16px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    transform-origin: 50% 100%;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding-inline: 14px;
    background: linear-gradient(#1c1c1e, #141416);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }
  .bar span {
    margin-inline: auto;
    font-size: 0.625rem;
    color: #8a8a8a;
    padding: 3px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  /* interface ilustrativa — skeleton do ds3 (.sk) */
  .ui {
    aspect-ratio: 16 / 12;
    display: grid;
    background: radial-gradient(80% 70% at 85% 0%, rgba(var(--glow-a), 0.12), transparent 70%),
      radial-gradient(60% 60% at 0% 100%, rgba(var(--glow-c), 0.1), transparent 70%), #0d0d0e;
  }
  .ui-main {
    padding: 6% 7% 6%;
    display: flex;
    flex-direction: column;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .av {
    flex: none;
    width: clamp(30px, 4.4vw, 40px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: linear-gradient(140deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.3));
  }
  .nm {
    flex: 1;
    display: grid;
    gap: 7px;
  }
  .sk {
    display: block;
    height: 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
  }
  .sk.h {
    height: clamp(9px, 1.3vw, 13px);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.85);
  }
  .sk.x {
    height: 6px;
    margin-top: 7px;
  }
  .nm .sk.x {
    margin-top: 0;
  }
  .opts {
    list-style: none;
    margin-top: auto;
    display: grid;
    gap: 5px;
  }
  .opts li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: clamp(0.5625rem, 0.85vw, 0.6875rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    animation: heroPick 12s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 4s);
  }
  .opts i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .opts svg {
    width: 12px;
    height: 12px;
    margin-left: auto;
    opacity: 0;
    animation: heroPickIcon 12s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 4s);
  }
  .cta-sk {
    display: block;
    width: 38%;
    height: clamp(18px, 2.4vw, 24px);
    margin-top: 10px;
    border-radius: 999px;
    background: #fff;
  }
  @keyframes heroPick {
    0%,
    26% {
      color: #fff;
      background: rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    }
    32%,
    100% {
      color: rgba(255, 255, 255, 0.55);
      background: rgba(255, 255, 255, 0.04);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    }
  }
  @keyframes heroPickIcon {
    0%,
    26% {
      opacity: 1;
    }
    32%,
    100% {
      opacity: 0;
    }
  }

  .hv-cap {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem;
    border-radius: 0 0 56px 56px;
    color: var(--t-light);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  }
  .cap-sm {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--t-light-2);
  }
  .note {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px 9px 9px;
    border-radius: 14px;
    background: #f5f5f5;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
    transform: rotate(var(--r));
    animation: heroFloat 5s ease-in-out infinite;
    animation-delay: var(--dl);
  }
  .n1 {
    top: 60%;
    left: -2%;
  }
  .n2 {
    top: 72%;
    right: 0;
  }
  .note i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--black);
    color: #fff;
  }
  .note svg {
    width: 15px;
    height: 15px;
  }
  .note b {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--t-dark);
    white-space: nowrap;
  }
  .note small {
    display: block;
    font-size: 0.6875rem;
    color: #6b6b6b;
  }
  @keyframes heroFloat {
    50% {
      transform: rotate(var(--r)) translateY(-10px);
    }
  }
  @keyframes heroBreathe {
    to {
      transform: translate3d(-8%, 6%, 0) scale(1.12);
      opacity: 0.7;
    }
  }

  /* ---------- Entrada (ds3) — começa quando a cortina sai ---------- */
  :global(.js) .ln > span {
    transform: translateY(110%);
    transition: transform 0.9s var(--ease-emph) calc(0.2s + var(--i) * 0.09s);
  }
  :global(.js) .fu {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s var(--ease-emph) var(--d), transform 0.9s var(--ease-emph) var(--d);
  }
  :global(.js) .hv {
    opacity: 0;
    transform: translateY(40px) scale(0.96);
    transition: opacity 1.1s var(--ease-emph) 0.6s, transform 1.1s var(--ease-emph) 0.6s;
  }
  :global(.js) .hv-img {
    clip-path: inset(100% 0 0 0 round 16px);
    transform: translateY(40px) rotateX(14deg) rotateY(-8deg) scale(0.92);
    transition: clip-path 1.3s var(--ease-emph) 0.75s, transform 1.6s var(--ease-emph) 0.75s;
  }
  :global(.go) .ln > span,
  :global(.go) .fu,
  :global(.go) .hv,
  :global(.go) .hv-img {
    transform: none;
    opacity: 1;
  }
  :global(.go) .hv-img {
    clip-path: inset(0 0 0 0 round 16px);
  }

  /* ---------- Marquee (ds3) ---------- */
  .band {
    --fade: 72px;
    padding-block: clamp(2.5rem, 4vw, 4rem);
    border-block: 1px solid rgba(0, 0, 0, 0.12);
    overflow: hidden;
    /* bordas que dissolvem: o corte dos itens nas laterais passa a ser intencional */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
  }
  .track {
    display: flex;
    width: max-content;
    /* o primeiro item parte já dentro da área visível, alinhado após a dissolução */
    margin-left: var(--fade);
    gap: 20px;
    animation: heroMq var(--dur, 40s) linear infinite;
    will-change: transform;
  }
  .track:hover {
    animation-play-state: paused;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding-inline: 32px;
    border-radius: 999px;
    background: #e1e1e1;
    color: #202020;
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.28s var(--ease-std), transform 0.28s var(--ease-std);
  }
  .chip:hover {
    background: #d4d4d4;
    transform: translateY(-1px);
  }
  @keyframes heroMq {
    to {
      transform: translateX(calc(-50% - 10px));
    }
  }

  /* ---------- Responsivo (ds3) ---------- */
  @media (max-width: 900px) {
    .hero {
      padding-top: 8.5rem;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }
  @media (max-width: 640px) {
    .wrap {
      width: calc(100% - 40px);
    }
    .hv-panel {
      border-radius: 40px;
    }
    .hv-cap {
      border-radius: 0 0 40px 40px;
      padding: 1.5rem;
    }
    .note {
      padding: 7px 14px 7px 7px;
    }
    .n1 {
      top: 56%;
    }
    .n2 {
      top: 65%;
    }
    .hv-cap .h3 {
      font-size: 1.125rem;
    }
    .note i {
      width: 24px;
      height: 24px;
    }
    .note svg {
      width: 13px;
      height: 13px;
    }
    .hero-cta .hbtn {
      width: 100%;
    }
    .hbtn-lg {
      height: auto;
      min-height: 60px;
      padding: 14px 24px;
      white-space: normal;
      text-align: center;
    }
    .chip {
      min-height: 48px;
      padding-inline: 24px;
      font-size: 0.9375rem;
    }
    .band {
      --fade: 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
