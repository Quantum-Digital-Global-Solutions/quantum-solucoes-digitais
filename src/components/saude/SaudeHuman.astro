---
/**
 * 3. TECNOLOGIA SEM PERDER O LADO HUMANO — seção conceitual, dobra escura.
 * Título central em escala grande, três parágrafos curtos e, por fim, os dois lados do projeto
 * (quem procura ajuda · quem atende) unidos por um nó de luz. Sem biografia e sem autoridade pessoal.
 */
import Icon from '../Icon.astro';
import { human } from '../../data/saude';
---

<section class="section human" id="lado-humano" data-tone="0" aria-labelledby="humano-title">
  <div class="glow" aria-hidden="true">
    <i style="left:8%;background:rgb(var(--amb-blue))"></i>
    <i style="left:42%;background:rgb(var(--amb-deep));animation-delay:-2s"></i>
    <i style="left:72%;background:rgb(var(--amb-orange));animation-delay:-4s"></i>
  </div>

  <div class="container">
    <div class="head">
      <span class="pill bg-grad rv">{human.pill}</span>
      <h2 class="h2" id="humano-title" data-split>{human.title} <span class="grad">{human.accent}</span></h2>
    </div>

    <div class="copy">
      <p class="body-lg rv" style="--d:.2s">{human.text[0]}</p>
      <div class="two">
        <p class="body-lg rv" style="--d:.3s">{human.text[1]}</p>
        <p class="body-lg rv" style="--d:.4s">{human.text[2]}</p>
      </div>
    </div>

    <p class="bridge rv" style="--d:.1s">{human.bridge}</p>

    <div class="duo">
      <div class="side s-glass bg-grad rv">
        <span class="hair"></span>
        <span class="circle" aria-hidden="true">
          <Icon name={human.sides[0].icon} />
        </span>
        <p class="st">{human.sides[0].text}</p>
      </div>
      <span class="join rv" style="--d:.15s" aria-hidden="true">
        <span class="line"></span>
        <span class="node">{human.join}</span>
        <span class="line"></span>
      </span>
      <div class="side s-glass bg-grad rv" style="--d:.12s">
        <span class="hair"></span>
        <span class="circle" aria-hidden="true">
          <Icon name={human.sides[1].icon} />
        </span>
        <p class="st">{human.sides[1].text}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .human {
    position: relative;
    overflow: hidden;
    /* fundo escuro próprio: os textos claros não dependem do tom por scroll; dissolve a partir da dobra clara acima */
    background: linear-gradient(180deg, rgba(0, 0, 0, 0), #000 64px);
    color: #fafafa;
  }
  .glow {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6%;
    height: 40%;
    pointer-events: none;
    opacity: 0.4;
  }
  .glow i {
    position: absolute;
    top: 50%;
    width: 26%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: 0 -50%;
    filter: blur(70px);
    opacity: 0.55;
    animation: breathe 9s ease-in-out infinite;
  }
  .container {
    position: relative;
  }
  .head {
    text-align: center;
  }
  .head .h2 {
    max-width: 14ch;
    margin: 26px auto 0;
    font-size: clamp(2.75rem, 6.6vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.05em;
  }
  .copy {
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    max-width: 62rem;
    display: grid;
    gap: 22px;
    text-align: center;
  }
  .copy > .body-lg:first-child {
    max-width: 44ch;
    margin-inline: auto;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    color: #fff;
    letter-spacing: -0.02em;
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    text-align: left;
  }
  .two .body-lg {
    color: var(--n300);
    font-size: 1.0625rem;
  }
  .bridge {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--gray);
  }
  .duo {
    position: relative;
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
  }
  .side {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 56px;
    min-height: 240px;
    padding: 30px;
    border-radius: 24px;
    transition: transform 0.6s var(--ease-emphasis), box-shadow 0.5s;
  }
  .side:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px var(--ring-s);
  }
  .side:hover .circle {
    transform: rotate(45deg);
    background: #262626;
  }
  .st {
    margin-top: auto;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  /* nó de luz que une os dois lados */
  .join {
    display: flex;
    align-items: center;
    width: clamp(96px, 11vw, 160px);
    pointer-events: none;
  }
  .line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.5));
  }
  .line:last-child {
    transform: scaleX(-1);
  }
  .node {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    font-size: 1.125rem;
    font-weight: 600;
    font-style: italic;
    color: #000;
    background: #fff;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.08), 0 0 50px rgba(var(--amb-violet), 0.5);
  }

  @media (max-width: 1000px) {
    .two {
      grid-template-columns: 1fr;
      gap: 18px;
      text-align: center;
    }
    .duo {
      grid-template-columns: 1fr;
    }
    .join {
      width: auto;
      height: 96px;
      flex-direction: column;
      justify-self: center;
    }
    .line {
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.5));
    }
    .line:last-child {
      transform: scaleY(-1);
    }
    .side {
      min-height: 0;
      gap: 36px;
    }
  }
  @media (max-width: 640px) {
    .side {
      padding: 24px;
    }
  }
</style>
