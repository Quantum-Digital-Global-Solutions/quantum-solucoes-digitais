---
/**
 * 5. JORNADA DO PACIENTE — ds2 · dobra clara.
 * Composição própria (diferente da jornada de Hospedagem): cabeçalho em duas colunas e três momentos
 * lado a lado, ligados por uma linha que se desenha. O do meio — a decisão — inverte para dark.
 */
import { journey } from '../../data/saude';
---

<section class="section" id="jornada" data-tone="1" aria-labelledby="jornada-title">
  <div class="container">
    <div class="head">
      <div class="l">
        <span class="pill ad rv">{journey.pill}</span>
        <h2 class="h2" id="jornada-title" data-split>{journey.title}</h2>
      </div>
      <div class="r">
        <p class="lead rv" style="--d:.2s">{journey.lead}</p>
        <ul class="cases">
          {journey.cases.map((c, k) => <li class="rv" style={`--d:${0.28 + k * 0.08}s`}>{c}</li>)}
        </ul>
        <p class="back rv" style="--d:.55s">{journey.backstage}</p>
      </div>
    </div>

    <p class="label rv">{journey.stagesLabel}</p>
    <ol class="stages">
      {
        journey.stages.map((s, k) => (
          <li class:list={['stage', 'rv', s.dark && 'is-dark']} style={`--d:${k * 0.12}s`}>
            <div class="rail" aria-hidden="true"><span class="node"><i></i></span><span class="bar"></span></div>
            <div class:list={['box', s.dark ? 'dk' : 's-light']}>
              <span class="hair"></span>
              <header>
                <span class:list={['pill', !s.dark && 'lt']}>{s.n}</span>
                <h3 class="st">{s.title}</h3>
              </header>
              <ul class="lines">
                {s.lines.map((l) => <li>{l}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: end;
  }
  .head .h2 {
    margin-top: 24px;
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    text-wrap: balance;
  }
  .lead {
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .cases {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }
  .cases li {
    position: relative;
    padding-left: 22px;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--n600);
  }
  .cases li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: currentColor;
  }
  .back {
    margin-top: 18px;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--n600);
    max-width: 44ch;
  }
  .label {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--n500);
  }

  .stages {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  /* linha-guia: nó + barra que se estende até o próximo momento */
  .rail {
    position: relative;
    display: flex;
    align-items: center;
    height: 15px;
    margin-bottom: 18px;
  }
  .node {
    display: grid;
    place-items: center;
    flex: none;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--off);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
  }
  .node i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    transform: scale(0);
    transition: transform 0.7s var(--ease-emphasis) 0.35s;
  }
  .stage:global(.in) .node i {
    transform: scale(1);
  }
  .is-dark .node i {
    background: #7c3aed;
  }
  .bar {
    flex: 1;
    height: 1px;
    margin-left: 10px;
    background: rgba(0, 0, 0, 0.18);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.2s var(--ease-emphasis) 0.5s;
  }
  .stage:global(.in) .bar {
    transform: scaleX(1);
  }
  .stage:last-child .bar {
    opacity: 0;
  }

  .box {
    position: relative;
    flex: 1;
    padding: 30px 28px 28px;
    border-radius: 20px;
    transition: transform 0.6s var(--ease-emphasis);
  }
  .box:hover {
    transform: translateY(-4px);
  }
  .box header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .st {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  .lines {
    margin-top: 26px;
    display: grid;
    gap: 11px;
    padding-top: 20px;
    border-top: 1px solid var(--ring-l);
  }
  .lines li {
    position: relative;
    padding-left: 18px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--n600);
  }
  .lines li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
  }
  /* a rotina: superfície dark sólida (ds2 .panel.on) */
  .box.dk {
    color: #fafafa;
    background: radial-gradient(520px 220px at 95% 120%, rgba(var(--amb-violet), 0.2), transparent), #0a0a0a;
    box-shadow: inset 0 0 0 1px var(--ring), 0 30px 60px -24px rgba(0, 0, 0, 0.45);
  }
  .box.dk .lines {
    border-top-color: var(--ring);
  }
  .box.dk .lines li {
    color: var(--n300);
  }

  @media (max-width: 1000px) {
    .head {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .stages {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 34px;
    }
    .stage {
      padding-bottom: 18px;
    }
    /* mobile/tablet: linha-guia vertical à esquerda */
    .rail {
      position: absolute;
      left: -34px;
      top: 30px;
      bottom: -18px;
      height: auto;
      margin: 0;
      flex-direction: column;
      align-items: center;
      width: 15px;
    }
    .bar {
      width: 1px;
      height: auto;
      margin: 6px 0 0;
      transform-origin: top;
      transform: scaleY(0);
    }
    .stage:global(.in) .bar {
      transform: scaleY(1);
    }
  }
  @media (max-width: 560px) {
    .stages {
      padding-left: 28px;
    }
    .rail {
      left: -28px;
    }
    .box {
      padding: 24px 22px;
    }
  }
</style>
