---
/**
 * 4. NOSSA ABORDAGEM — ds2 · dobra clara. A pergunta central da Quantum em duas linhas
 * ("Qual site você quer?" → "O que o seu negócio precisa fazer melhor?") e os três pontos que se busca entender.
 */
import { approach } from '../../data/sobmedida';
---

<section class="section appr" id="abordagem" data-tone="1" aria-labelledby="abordagem-title">
  <div class="container">
    <div class="head">
      <span class="pill ad rv">{approach.pill}</span>
      <h2 class="h2" id="abordagem-title" data-split>{approach.title} {approach.accent}</h2>
    </div>

    <div class="q rv" style="--d:.15s">
      <p class="from"><s>{approach.from}</s></p>
      <p class="to">{approach.to}</p>
    </div>

    <div class="und">
      <p class="lead rv">{approach.lead}</p>
      <ol class="pts">
        {
          approach.points.map((p, k) => (
            <li class="rv" style={`--d:${k * 0.1}s`}>
              <span class="n">{p.n}</span>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="closing rv">{approach.closing}</p>
    </div>
  </div>
</section>

<style>
  .appr {
    padding-top: clamp(4rem, 8vw, 7rem);
  }
  .head {
    text-align: center;
  }
  .head .h2 {
    max-width: 17ch;
    margin: 24px auto 0;
    font-size: clamp(2.25rem, 4.8vw, 4rem);
    text-wrap: balance;
  }
  .q {
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    max-width: 60rem;
    text-align: center;
  }
  .from {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--n500);
  }
  .from s {
    text-decoration-thickness: 1px;
  }
  .to {
    margin-top: 14px;
    font-size: clamp(1.75rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .und {
    margin: clamp(3.5rem, 7vw, 6rem) auto 0;
    max-width: 62rem;
  }
  .lead {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--n500);
  }
  .pts {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ring-l);
  }
  .pts li {
    padding: 26px 28px 30px 0;
    border-bottom: 1px solid var(--ring-l);
  }
  .pts li + li {
    padding-left: 28px;
    border-left: 1px solid var(--ring-l);
  }
  .n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--n500);
  }
  .pts p {
    margin-top: 28px;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .closing {
    margin-top: 28px;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  @media (max-width: 800px) {
    .pts {
      grid-template-columns: 1fr;
    }
    .pts li,
    .pts li + li {
      padding: 22px 0;
      border-left: 0;
    }
    .pts p {
      margin-top: 12px;
    }
  }
</style>
