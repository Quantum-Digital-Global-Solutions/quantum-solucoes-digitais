---
/**
 * HERO · Soluções Sob Medida — derivado do ds3.html e da Hero da Home, com fotografia de fundo.
 * Composição própria: janela com quatro módulos que se "montam" conforme a necessidade (decorativa).
 * Tokens do ds3 isolados neste componente.
 *
 * Fundo fotográfico: "Woman in Pink Long Sleeve Shirt Sitting on Chair Using Laptop" (Ron Lach, Pexels — licença
 * Pexels, uso comercial livre), em WebP (public/images/sobmedida-hero-*.webp), com overlay escuro em gradiente.
 * Mesmo tratamento das Heroes de Hospedagem e Saúde; níveis ajustados à luz desta foto (clara e de baixo contraste).
 */
import { hero } from '../../data/sobmedida';
import { CTA, SITE } from '../../data/site';

const arrow = '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>';
const check = '<path d="M20 6 9 17l-5-5"/>';
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true">
    <img
      src="/images/sobmedida-hero-2560.webp"
      srcset="/images/sobmedida-hero-1280.webp 1280w, /images/sobmedida-hero-2560.webp 2560w"
      sizes="100vw"
      alt=""
      width="2560"
      height="1707"
      fetchpriority="high"
      decoding="async"
    />
    <span class="shade"></span>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow fu" style="--d:.1s">{hero.eyebrow}</p>
      <h1 id="hero-title" class="display">
        {
          hero.lines.map((l, k) => (
            <Fragment>
              <span class="ln"><span style={`--i:${k}`}>{l}</span></span>{' '}
            </Fragment>
          ))
        }
        <span class="ln pb"><span style={`--i:${hero.lines.length}`}><em class="it">{hero.accent}</em></span></span>
      </h1>
      {hero.text.map((t, k) => <p class:list={['lead', 'fu', k > 0 && 'lead-2']} style={`--d:${0.4 + k * 0.1}s`}>{t}</p>)}
      <div class="hero-cta fu" style="--d:.65s">
        <a href={CTA.href} class="hbtn hbtn-primary hbtn-lg" target="_blank" rel="noopener">
          <span class="sheen"></span>{hero.cta}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
        </a>
      </div>
      <p class="complement fu" style="--d:.75s"><span class="dot-s" aria-hidden="true"></span>{hero.complement}</p>
    </div>

    <!-- Composição visual (decorativa) -->
    <div class="hv" aria-hidden="true">
      <div class="hv-panel"><span class="amb a1"></span><span class="amb a2"></span></div>
      <span class="hv-ghost"></span>
      <div class="hv-3d">
        <figure class="hv-img">
          <div class="bar"><i></i><i></i><i></i><span>solução sob medida</span></div>
          <div class="ui">
            <span class="sk e"></span>
            <span class="sk h" style="width:74%"></span>
            <span class="sk h" style="width:46%;opacity:.55"></span>
            <ul class="mods">
              {
                hero.modules.map((m, k) => (
                  <li style={`--k:${k}`}>
                    <i />
                    <span>{m}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={check} />
                  </li>
                ))
              }
            </ul>
          </div>
        </figure>
      </div>
      <div class="note n1" style="--r:-4deg;--dl:0s">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"></path></svg></i>
        <span><b>Entender o momento</b><small>Antes da ferramenta</small></span>
      </div>
      <div class="note n2" style="--r:3deg;--dl:1.4s">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></i>
        <span><b>Definir a solução</b><small>Conforme o objetivo</small></span>
      </div>
      <div class="hv-cap">
        <div>
          <p class="h3">Do objetivo à solução</p>
          <p class="cap-sm">{SITE.name}</p>
        </div>
        <span class="ibtn ibtn-d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} /></span>
      </div>
    </div>
  </div>

  <!-- Faixa em marquee (ds3) — exemplos e capacidades citados no briefing §5 -->
  <div class="band" aria-hidden="true">
    <div class="track" style="--dur:52s">
      {hero.band.map((c) => <span class="chip">{c}</span>)}
      {hero.band.map((c) => <span class="chip dup">{c}</span>)}
    </div>
  </div>
</section>

<style>
  /* =========================================================
     TOKENS ds3 — escopo exclusivo da Hero
     ========================================================= */
  .hero {
    --black: #080808;
    --off: #f2f2f2;
    --t-dark: #f5f5f5;
    --t-dark-2: #d9d9d9;
    --t-light: #f5f5f5;
    --t-light-2: #b8b8b8;
    --b-dark: rgba(255, 255, 255, 0.08);
    --b-dark-s: rgba(255, 255, 255, 0.14);
    --glow-a: 59, 130, 246;
    --glow-b: 249, 115, 22;
    --glow-c: 168, 85, 247;
    --font: 'Instrument Sans', 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --fs-display: clamp(2rem, 3.6vw, 3.6rem);
    --fs-h3: clamp(1.25rem, 1.7vw, 1.6rem);
    --fs-body: clamp(1.05rem, 1.25vw, 1.25rem);
    --ease-std: cubic-bezier(0.2, 0.8, 0.2, 1);
    --ease-emph: cubic-bezier(0.16, 1, 0.3, 1);
    --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 40px rgba(0, 0, 0, 0.06);
    --shadow-dark: 0 28px 80px rgba(0, 0, 0, 0.3);

    position: relative;
    overflow: hidden;
    padding-top: clamp(8.5rem, 12vw, 11rem);
    background: #050505;
    color: var(--t-dark);
    font-family: var(--font);
  }

  /* ---------- Fundo fotográfico + overlay ---------- */
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* a profissional fica no centro-direita, entre o texto e o painel; a arara de roupas aparece atrás do painel */
    object-position: 52% 42%;
    filter: brightness(1.04) saturate(1.04);
  }
  /* foto clara e de baixo contraste: o escurecimento sustenta o texto até cerca de 40% e some antes do rosto (centro) */
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(5, 6, 10, 0.84) 0%, rgba(5, 6, 10, 0.82) 20%, rgba(5, 6, 10, 0.74) 34%, rgba(5, 6, 10, 0.5) 44%, rgba(5, 6, 10, 0.2) 52%, rgba(5, 6, 10, 0.08) 62%, rgba(5, 6, 10, 0.1) 78%, rgba(5, 6, 10, 0.22) 100%),
      linear-gradient(180deg, rgba(5, 6, 10, 0.5) 0%, rgba(5, 6, 10, 0) 18%, rgba(5, 6, 10, 0) 62%, rgba(5, 5, 5, 0.9) 100%);
  }
  .hero-grid,
  .band {
    position: relative;
    z-index: 1;
  }
  .wrap {
    width: min(100% - 48px, 1360px);
    margin-inline: auto;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  /* ---------- Tipografia (ds3) ---------- */
  .eyebrow {
    margin-bottom: 2rem;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #d0d0d0;
  }
  .display {
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.056em;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .ln > span {
    display: block;
  }
  .ln.pb {
    padding-bottom: 0.16em;
  }
  .it {
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    font-size: 1.08em;
    line-height: 1.05;
    padding-right: 0.06em;
  }
  .lead {
    margin-top: 2rem;
    max-width: 50ch;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--t-dark-2);
  }
  .lead-2 {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.1vw, 1.125rem);
  }
  .h3 {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  /* ---------- Botões (ds3) ---------- */
  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }
  .hbtn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding-inline: 28px;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.28s var(--ease-std), background 0.28s var(--ease-std), box-shadow 0.28s var(--ease-std);
  }
  .hbtn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }
  .hbtn svg {
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform 0.28s var(--ease-std);
  }
  .hbtn:hover svg {
    transform: translate(2px, -2px);
  }
  .hbtn-lg {
    height: 60px;
    padding-inline: 36px;
    font-size: 1rem;
  }
  .hbtn-primary {
    background: #fff;
    color: #080808;
    border: 1px solid #fff;
  }
  .hbtn-primary:hover {
    background: #ececec;
  }
  .sheen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    z-index: -1;
    pointer-events: none;
  }
  .sheen::after {
    content: '';
    position: absolute;
    top: 0;
    left: -50%;
    width: 50%;
    height: 100%;
    background: rgba(0, 0, 0, 0.1);
    filter: blur(4px);
    transform: skewX(12deg);
    opacity: 0;
    transition: transform 0.7s, opacity 0.7s;
  }
  .hbtn:hover .sheen::after {
    transform: translateX(320%) skewX(12deg);
    opacity: 0.5;
  }
  .hbtn:focus-visible {
    outline: 2px solid var(--t-dark);
    outline-offset: 4px;
  }
  .complement {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #cdcdcd;
  }
  .dot-s {
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: #fff;
  }
  .ibtn {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--t-light);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--b-dark-s);
  }
  .ibtn svg {
    width: 18px;
    height: 18px;
  }

  /* ---------- Composição visual (ds3 .hv) ---------- */
  .hv {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 534 / 660;
  }
  .hv-panel {
    position: absolute;
    inset: 15% 0 0;
    border-radius: 56px;
    background: radial-gradient(120% 70% at 50% 0%, rgba(255, 255, 255, 0.06), transparent 60%), rgba(8, 8, 8, 0.5);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    overflow: hidden;
    box-shadow: var(--shadow-dark), inset 0 0 0 1px var(--b-dark);
  }
  .amb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
    animation: heroBreathe 9s ease-in-out infinite alternate;
  }
  .a1 {
    width: 60%;
    height: 45%;
    top: -10%;
    right: -15%;
    background: rgba(var(--glow-a), 0.22);
  }
  .a2 {
    width: 55%;
    height: 40%;
    bottom: 10%;
    left: -20%;
    background: rgba(var(--glow-b), 0.14);
    animation-delay: -4s;
  }
  .hv-3d {
    position: absolute;
    inset: 0;
    perspective: 1400px;
    z-index: 2;
  }
  .hv-ghost {
    position: absolute;
    top: 0;
    left: 12%;
    width: 76%;
    aspect-ratio: 16 / 11;
    border-radius: 16px;
    background: #141416;
    transform: rotate(-6deg);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 20px 50px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }
  .hv-img {
    position: absolute;
    top: 3%;
    left: 5%;
    width: 90%;
    border-radius: 16px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    transform-origin: 50% 100%;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding-inline: 14px;
    background: linear-gradient(#1c1c1e, #141416);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }
  .bar span {
    margin-inline: auto;
    font-size: 0.625rem;
    color: #8a8a8a;
    padding: 3px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  /* interface ilustrativa — skeleton do ds3 (.sk) com módulos em grade 2×2 */
  .ui {
    aspect-ratio: 16 / 12;
    padding: 6% 7% 6%;
    display: flex;
    flex-direction: column;
    background: radial-gradient(80% 70% at 85% 0%, rgba(var(--glow-a), 0.12), transparent 70%),
      radial-gradient(60% 60% at 0% 100%, rgba(var(--glow-c), 0.1), transparent 70%), #0d0d0e;
  }
  .sk {
    display: block;
    height: 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
  }
  .sk.e {
    width: 26%;
    height: 5px;
  }
  .sk.h {
    height: clamp(10px, 1.5vw, 14px);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.85);
    margin-top: 8px;
  }
  .sk.e + .sk.h {
    margin-top: 12px;
  }
  .mods {
    list-style: none;
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .mods li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: clamp(38px, 5.6vw, 52px);
    padding: 8px 10px;
    border-radius: 10px;
    font-size: clamp(0.5625rem, 0.85vw, 0.6875rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    animation: heroPick 12s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 3s);
  }
  .mods i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .mods svg {
    flex: none;
    width: 12px;
    height: 12px;
    margin-left: auto;
    opacity: 0;
    animation: heroPickIcon 12s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 3s);
  }
  @keyframes heroPick {
    0%,
    24% {
      color: #fff;
      background: rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    }
    30%,
    100% {
      color: rgba(255, 255, 255, 0.55);
      background: rgba(255, 255, 255, 0.04);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    }
  }
  @keyframes heroPickIcon {
    0%,
    24% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0;
    }
  }

  .hv-cap {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem;
    border-radius: 0 0 56px 56px;
    color: var(--t-light);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  }
  .cap-sm {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--t-light-2);
  }
  .note {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px 9px 9px;
    border-radius: 14px;
    background: #f5f5f5;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
    transform: rotate(var(--r));
    animation: heroFloat 5s ease-in-out infinite;
    animation-delay: var(--dl);
  }
  .n1 {
    top: 61%;
    left: -2%;
  }
  .n2 {
    top: 71%;
    right: 0;
  }
  .note i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--black);
    color: #fff;
  }
  .note svg {
    width: 15px;
    height: 15px;
  }
  .note b {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #101010;
    white-space: nowrap;
  }
  .note small {
    display: block;
    font-size: 0.6875rem;
    color: #6b6b6b;
  }
  @keyframes heroFloat {
    50% {
      transform: rotate(var(--r)) translateY(-10px);
    }
  }
  @keyframes heroBreathe {
    to {
      transform: translate3d(-8%, 6%, 0) scale(1.12);
      opacity: 0.7;
    }
  }

  /* ---------- Entrada (ds3) — começa quando a cortina sai ---------- */
  :global(.js) .ln > span {
    transform: translateY(110%);
    transition: transform 0.9s var(--ease-emph) calc(0.2s + var(--i) * 0.09s);
  }
  :global(.js) .fu {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.9s var(--ease-emph) var(--d), transform 0.9s var(--ease-emph) var(--d);
  }
  :global(.js) .hv {
    opacity: 0;
    transform: translateY(40px) scale(0.96);
    transition: opacity 1.1s var(--ease-emph) 0.6s, transform 1.1s var(--ease-emph) 0.6s;
  }
  :global(.js) .hv-img {
    clip-path: inset(100% 0 0 0 round 16px);
    transform: translateY(40px) rotateX(14deg) rotateY(-8deg) scale(0.92);
    transition: clip-path 1.3s var(--ease-emph) 0.75s, transform 1.6s var(--ease-emph) 0.75s;
  }
  :global(.go) .ln > span,
  :global(.go) .fu,
  :global(.go) .hv,
  :global(.go) .hv-img {
    transform: none;
    opacity: 1;
  }
  :global(.go) .hv-img {
    clip-path: inset(0 0 0 0 round 16px);
  }

  /* ---------- Marquee (ds3) ---------- */
  .band {
    --fade: 72px;
    padding-block: clamp(2.5rem, 4vw, 4rem);
    border-block: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
    /* bordas que dissolvem: o corte dos itens nas laterais passa a ser intencional */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
  }
  .track {
    display: flex;
    width: max-content;
    /* o primeiro item parte já dentro da área visível, alinhado após a dissolução */
    margin-left: var(--fade);
    gap: 20px;
    animation: heroMq var(--dur, 40s) linear infinite;
    will-change: transform;
  }
  .track:hover {
    animation-play-state: paused;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding-inline: 32px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #f2f2f2;
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.28s var(--ease-std), transform 0.28s var(--ease-std);
  }
  .chip:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-1px);
  }
  @keyframes heroMq {
    to {
      transform: translateX(calc(-50% - 10px));
    }
  }

