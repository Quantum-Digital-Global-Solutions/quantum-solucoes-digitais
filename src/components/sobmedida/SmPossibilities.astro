---
/**
 * 3. POSSIBILIDADES DIGITAIS — dobra escura. Título à esquerda; à direita, seis capacidades em moldura glass
 * com linhas finas; embaixo, exemplos em pills e o aviso de que não é catálogo fechado.
 */
import Icon from '../Icon.astro';
import { possibilities } from '../../data/sobmedida';
---

<section class="section poss" id="possibilidades" data-tone="0" aria-labelledby="possibilidades-title">
  <div class="container">
    <div class="split">
      <div class="head">
        <span class="pill bg-grad rv">{possibilities.pill}</span>
        <h2 class="h2" id="possibilidades-title" data-split>{possibilities.title} <span class="grad">{possibilities.accent}</span></h2>
        <p class="body rv" style="--d:.3s">{possibilities.text}</p>
      </div>

      <div class="frame s-glass bg-grad rv" style="--d:.15s">
        <span class="hair"></span>
        <ul class="list">
          {
            possibilities.items.map((it, k) => (
              <li>
                <span class="n">{String(k + 1).padStart(2, '0')}</span>
                <div class="t">
                  <strong>{it.title}</strong>
                  <p>{it.text}</p>
                </div>
                <span class="circle" aria-hidden="true">
                  <Icon name="right" />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="ex">
      <p class="lbl rv">{possibilities.examplesLabel}</p>
      <ul class="pills">
        {possibilities.examples.map((e, k) => <li class="pill bg-grad rv" style={`--d:${k * 0.05}s`}>{e}</li>)}
      </ul>
      <p class="note rv">{possibilities.note}</p>
    </div>
  </div>
</section>

<style>
  .poss {
    /* fundo escuro próprio: os textos claros não dependem do tom por scroll; dissolve a partir da dobra clara acima */
    background: linear-gradient(180deg, rgba(0, 0, 0, 0), #000 64px, #000 calc(100% - 64px), rgba(0, 0, 0, 0));
    color: #fafafa;
  }
  .split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  .head .h2 {
    margin-top: 22px;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    text-wrap: balance;
  }
  .head .body {
    margin-top: 20px;
    max-width: 42ch;
  }
  .frame {
    padding: 10px 28px 18px;
    border-radius: 28px;
  }
  .list li {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--ring);
  }
  .list li:last-child {
    border-bottom: 0;
  }
  .n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gray);
  }
  .t strong {
    display: block;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .t p {
    margin-top: 4px;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--gray);
  }
  .t {
    transition: transform 0.6s var(--ease-emphasis);
  }
  .list .circle {
    width: 36px;
    height: 36px;
    color: var(--gray);
  }
  .list li:hover .t {
    transform: translateX(6px);
  }
  .list li:hover .circle {
    transform: rotate(45deg);
    background: #262626;
    color: #fff;
  }
  .ex {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 28px;
    border-top: 1px solid var(--ring);
  }
  .ex .lbl {
    color: var(--gray);
  }
  .pills {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pills .pill {
    padding: 7px 16px;
    font-size: 0.875rem;
    color: #e5e5e5;
  }
  .note {
    margin-top: 22px;
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--gray);
  }
  @media (max-width: 1000px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .frame {
      padding: 4px 18px 12px;
      border-radius: 24px;
    }
  }
</style>
