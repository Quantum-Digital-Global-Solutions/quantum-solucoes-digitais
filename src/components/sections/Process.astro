---
/**
 * 8. DA NECESSIDADE À SOLUÇÃO — painéis expansivos do ds2 (dobra clara).
 * Hover, foco ou toque expande a etapa: flex 1 → 4, inversão claro → dark glass.
 */
import SectionHead from '../SectionHead.astro';
import Button from '../Button.astro';
import { process } from '../../data/home';
import { CTA } from '../../data/site';
---

<section class="section" id="processo" data-tone="1" aria-labelledby="processo-title">
  <div class="container">
    <SectionHead id="processo-title" tone="light" pill={process.pill} title={process.title} text={process.text} />
    <ol class="panels rv" style="--d:.45s" data-panels>
      {
        process.steps.map((s, k) => (
          <li class:list={['panel', k === 0 && 'on']} tabindex="0">
            <span class="pn-k">{String(k + 1).padStart(2, '0')}</span>
            <div class="pn-body">
              <h3 class="h3">{s.title}</h3>
              <p class="body">{s.text}</p>
            </div>
            <span class="pn-v" aria-hidden="true">
              {s.title}
            </span>
          </li>
        ))
      }
    </ol>
    <div class="actions rv cta-row">
      <Button href={CTA.href}>{CTA.label}</Button>
    </div>
  </div>
</section>

<style>
  .panels {
    display: flex;
    gap: 12px;
    min-height: 440px;
  }
  .panel {
    flex: 1 1 0;
    min-width: 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    border-radius: 16px;
    cursor: pointer;
    outline: none;
    background: rgba(255, 255, 255, 0.72);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ring-l), 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: flex 0.7s var(--ease-emphasis), background 0.5s var(--ease-standard), color 0.5s var(--ease-standard), box-shadow 0.5s;
  }
  .panel:focus-visible {
    box-shadow: inset 0 0 0 2px #000;
  }
  .panel:global(.on) {
    flex: 4 1 0;
    color: #fafafa;
    background: radial-gradient(700px 240px at 90% 120%, rgba(var(--amb-violet), 0.16), transparent), #0a0a0a;
    box-shadow: inset 0 0 0 1px var(--ring), 0 30px 60px -24px rgba(0, 0, 0, 0.45);
  }
  .panel:global(.on):focus-visible {
    box-shadow: inset 0 0 0 2px #fff, 0 30px 60px -24px rgba(0, 0, 0, 0.45);
  }
  .pn-k {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .pn-body {
    width: 100%;
    max-width: 440px;
    min-width: 260px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s, transform 0.6s var(--ease-emphasis);
  }
  .panel:global(.on) .pn-body {
    opacity: 1;
    transform: none;
    transition-delay: 0.25s;
  }
  .pn-body .body {
    margin-top: 12px;
  }
  .panel:not(:global(.on)) .body {
    color: var(--n600);
  }
  .pn-v {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 26px;
    display: flex;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--n600);
    transition: opacity 0.4s;
  }
  .panel:global(.on) .pn-v {
    opacity: 0;
  }
  .cta-row {
    margin-top: 48px;
  }

  @media (max-width: 1000px) {
    .panels {
      flex-direction: column;
      min-height: 0;
    }
    .panel,
    .panel:global(.on) {
      flex: none;
    }
    .pn-body {
      min-width: 0;
      width: auto;
      margin-top: 14px;
      opacity: 1;
      transform: none;
    }
    .pn-v {
      display: none;
    }
  }
</style>
