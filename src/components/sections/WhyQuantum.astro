---
/** 9. POR QUE QUANTUM — cartão glass com linhas editoriais (padrão type-card/trow do ds2) */
import SectionHead from '../SectionHead.astro';
import { why } from '../../data/home';
---

<section class="section why" id="por-que-quantum" data-tone="0" aria-labelledby="por-que-title">
  <div class="container">
    <SectionHead id="por-que-title" pill={why.pill} title={why.title} accent={why.accent} />
    <div class="type-card s-glass bg-grad rv" style="--d:.3s">
      <span class="hair"></span>
      <ol>
        {
          why.items.map((it, k) => (
            <li class="trow">
              <div class="lft">
                <span class="lbl">{String(k + 1).padStart(2, '0')}</span>
                <h3 class="h3">{it.title}</h3>
              </div>
              <p class="stmt" data-split>
                {it.text}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .why {
    background: radial-gradient(70% 40% at 50% 0%, rgba(64, 29, 191, 0.12), transparent 70%);
  }
  .type-card {
    padding: 8px 40px;
    border-radius: 24px;
  }
  .trow {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: center;
    padding: 40px 0;
    border-top: 1px solid var(--ring);
  }
  .trow:first-child {
    border-top: 0;
  }
  .lft .h3 {
    margin-top: 10px;
  }
  .lbl {
    color: var(--gray);
    letter-spacing: 0.08em;
  }
  .stmt {
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.035em;
    color: #fafafa;
    text-wrap: balance;
  }
  @media (max-width: 760px) {
    .type-card {
      padding: 4px 22px;
    }
    .trow {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 28px 0;
    }
  }
</style>
