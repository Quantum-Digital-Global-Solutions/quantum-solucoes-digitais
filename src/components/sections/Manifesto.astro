---
/**
 * 3. MANIFESTO — cena sticky do ds2: claro → cinza → preto guiado pelo scroll.
 * As palavras acendem uma a uma; os quatro exemplos (briefing §8) acompanham
 * a transição de superfície clara para dark glass.
 */
import { manifesto } from '../../data/home';
---

<section class="scene" id="manifesto" data-scene data-tone-in="1" data-tone="0" aria-labelledby="manifesto-title">
  <div class="scene-st">
    <div class="scene-glow"></div>
    <div class="container in">
      <p class="top"><span class="pill ad">{manifesto.pill}</span></p>
      <h2 class="manifesto" id="manifesto-title" data-words>{manifesto.text}</h2>
      <p class="intro">{manifesto.intro}</p>
      <ul class="ex">
        {
          manifesto.examples.map((e, k) => (
            <li class="adapt" style={`--k:${k}`}>
              <span class="k">{String(k + 1).padStart(2, '0')}</span>
              <strong>{e.title}</strong>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .scene {
    position: relative;
    height: 270vh;
    --p: 0;
    --bp: clamp(0, calc(var(--p) / 0.55), 1);
    --ik: clamp(0, calc((var(--bp) - 0.44) / 0.14), 1);
  }
  .scene-st {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: color-mix(in srgb, #000 calc(var(--bp) * 100%), #f5f5f5);
    color: color-mix(in srgb, #fafafa calc(var(--ik) * 100%), #0a0a0a);
  }
  .scene-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: clamp(0, calc((var(--p) - 0.5) / 0.35), 1);
    background: radial-gradient(60% 50% at 50% 110%, rgba(var(--amb-deep), 0.22), transparent 70%),
      radial-gradient(40% 30% at 85% 0%, rgba(var(--amb-blue), 0.1), transparent 70%);
  }
  .in {
    position: relative;
    padding-top: 56px;
  }
  .top {
    text-align: center;
    margin-bottom: 32px;
  }
  .manifesto {
    position: relative;
    max-width: 22ch;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(2.1rem, 4.6vw, 4rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }
  .manifesto :global(.w) {
    --wp: clamp(0, calc((var(--p) - 0.1 - var(--i) * 0.03) / 0.22), 1);
    display: inline-block;
    opacity: calc(0.15 + var(--wp) * 0.85);
    transform: translateY(calc((1 - var(--wp)) * 20px));
  }

  .intro {
    position: relative;
    max-width: 52ch;
    margin: clamp(1rem, 2.5vh, 1.5rem) auto 0;
    text-align: center;
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    line-height: 1.5;
    opacity: clamp(0, calc((var(--p) - 0.3) / 0.15), 1);
  }

  /* exemplos — mesmo card "adapt" do ds2: superfície clara → dark glass */
  .ex {
    position: relative;
    margin-top: clamp(2.5rem, 7vh, 5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .adapt {
    --cp: clamp(0, calc((var(--p) - 0.48 - var(--k) * 0.05) / 0.14), 1);
    position: relative;
    padding: 20px;
    border-radius: 16px;
    text-align: left;
    background: color-mix(in srgb, rgba(23, 23, 23, 0.6) calc(var(--ik) * 100%), rgba(255, 255, 255, 0.72));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, rgba(255, 255, 255, 0.1) calc(var(--ik) * 100%), rgba(0, 0, 0, 0.08));
    opacity: var(--cp);
    transform: translateY(calc((1 - var(--cp)) * 24px));
  }
  .k {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }
  .adapt strong {
    display: block;
    margin-top: 8px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .adapt p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  :global(.no-js) .scene {
    height: auto;
    --p: 1;
  }
  :global(.no-js) .scene-st {
    position: relative;
    height: auto;
    min-height: 100svh;
    padding-block: 7rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .scene {
      height: auto;
      --p: 1;
    }
    .scene-st {
      position: relative;
      height: auto;
      min-height: 100svh;
      padding-block: 7rem;
    }
  }

  @media (max-width: 900px) {
    .ex {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .in {
      padding-top: 64px;
    }
    .top {
      margin-bottom: 20px;
    }
    .manifesto {
      font-size: clamp(1.75rem, 7.6vw, 2.25rem);
    }
    .ex {
      margin-top: 28px;
      gap: 8px;
    }
    .adapt {
      padding: 12px 14px;
      border-radius: 14px;
    }
    .adapt p {
      margin-top: 6px;
      font-size: 0.8125rem;
      line-height: 1.4;
    }
  }
  @media (max-width: 640px) and (max-height: 700px) {
    .manifesto {
      font-size: 1.625rem;
    }
    .adapt p {
      font-size: 0.75rem;
    }
  }
</style>
