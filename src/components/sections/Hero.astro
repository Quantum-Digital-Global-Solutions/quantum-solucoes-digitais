---
/**
 * HERO — fonte da verdade visual: ds3.html (exclusivamente aqui).
 * Tokens, tipografia (Instrument Sans), botões, superfícies e motion do ds3
 * ficam isolados neste componente para não vazar para o restante da Home (ds2).
 *
 * A janela de navegador do ds3 exibia uma foto de terceiro; aqui ela recebe uma
 * interface ilustrativa em CSS (sem imagens externas). As notas flutuantes usam
 * apenas fatos do briefing.
 */
import { hero } from '../../data/home';
import { CTA, SITE } from '../../data/site';

const arrow = '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>';
const options = hero.options;
/** Fundo fotográfico: as fotografias (já otimizadas) das Heroes de Hospedagem, Saúde e Sob Medida, em crossfade. */
const scenes = [
  { id: 'hospedagem', pos: '60% 55%', posM: '66% center' },
  { id: 'saude', pos: '6% 45%', posM: '52% center' },
  { id: 'sobmedida', pos: '52% 42%', posM: '40% 14%' },
];
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <!-- Fundo: três cenas em crossfade (Hospedagem · Saúde · Sob Medida). A copy e os elementos da Hero são fixos. -->
  <div class="bg" aria-hidden="true">
    {
      scenes.map((sc, k) => (
        <div class="scene" style={`--k:${k};--pos:${sc.pos};--posm:${sc.posM}`}>
          <img
            src={`/images/${sc.id}-hero-2560.webp`}
            srcset={`/images/${sc.id}-hero-1280.webp 1280w, /images/${sc.id}-hero-2560.webp 2560w`}
            sizes="100vw"
            alt=""
            width="2560"
            height="1707"
            decoding="async"
            fetchpriority={k === 0 ? 'high' : 'low'}
            loading={k === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))
    }
    <span class="shade"></span>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow fu" style="--d:.1s">{hero.eyebrow}</p>
      <h1 id="hero-title" class="display">
        <span class="ln"><span style="--i:0">{hero.titleLead}</span></span>
        <span class="ln pb"><span style="--i:1">{hero.titleTail} <em class="it">{hero.titleAccent}</em></span></span>
      </h1>
      <p class="lead fu" style="--d:.4s">{hero.subtitle}</p>
      <div class="hero-cta fu" style="--d:.55s">
        <a href={CTA.href} class="hbtn hbtn-primary hbtn-lg" target="_blank" rel="noopener">
          <span class="sheen"></span>{CTA.label}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
        </a>
        <a href={hero.secondary.href} class="hlink">
          <span class="ibtn" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
          </span>
          {hero.secondary.label}
        </a>
      </div>
    </div>

    <!-- Composição visual do ds3 (decorativa) -->
    <div class="hv" aria-hidden="true">
      <div class="hv-panel"><span class="amb a1"></span><span class="amb a2"></span></div>
      <span class="hv-ghost"></span>
      <div class="hv-3d">
        <figure class="hv-img">
          <div class="bar"><i></i><i></i><i></i><span>quantum · diagnóstico</span></div>
          <div class="ui">
            <div class="ui-side"><b></b><b></b><b></b><b></b></div>
            <div class="ui-main">
              <span class="sk e"></span>
              <span class="sk h" style="width:78%"></span>
              <span class="sk h" style="width:52%;opacity:.55"></span>
              <span class="sk x" style="width:64%;margin-top:14px"></span>
              <span class="sk x" style="width:46%;margin-top:7px"></span>
              <ul class="opts">
                {
                  options.map((o, k) => (
                    <li style={`--k:${k}`}>
                      <i />
                      <span>{o}</span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </figure>
      </div>
      <div class="note" style="top:55%;left:2%;--r:-4deg;--dl:0s">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m9 12 2 2 4-4"></path></svg></i>
        <span><b>Da necessidade à solução</b><small>Processo em seis etapas</small></span>
      </div>
      <div class="note" style="top:67%;right:4%;--r:3deg;--dl:1.4s">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></i>
        <span><b>Atendimento remoto</b><small>Brasil e exterior</small></span>
      </div>
      <div class="hv-cap">
        <div>
          <p class="h3">Estratégia, design e tecnologia</p>
          <p class="cap-sm">{SITE.name}</p>
        </div>
        <span class="ibtn ibtn-d"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} /></span>
      </div>
    </div>
  </div>

  <!-- Faixa em marquee (ds3) — somente frentes reais da Quantum -->
  <div class="band" aria-hidden="true">
    <div class="track" style="--dur:48s">
      {hero.band.map((c) => <span class="chip">{c}</span>)}
      {hero.band.map((c) => <span class="chip">{c}</span>)}
    </div>
  </div>
</section>

<style>
  /* =========================================================
     TOKENS ds3 — escopo exclusivo da Hero
     ========================================================= */
  .hero {
    --black: #080808;
    --black-deep: #050505;
    --black-soft: #111;
    --off: #f2f2f2;
    --gray: #818181;
    --t-dark: #f5f5f5;
    --t-dark-2: #d9d9d9;
    --t-light: #f5f5f5;
    --t-light-2: #b8b8b8;
    --b-dark: rgba(255, 255, 255, 0.08);
    --b-dark-s: rgba(255, 255, 255, 0.14);
    --glow-a: 59, 130, 246;
    --glow-b: 249, 115, 22;
    --glow-c: 168, 85, 247;
    --font: 'Instrument Sans', 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --fs-display: clamp(2.75rem, 5.1vw, 5.25rem);
    --fs-h3: clamp(1.25rem, 1.7vw, 1.6rem);
    --fs-body: clamp(1.1rem, 1.4vw, 1.375rem);
    --ease-std: cubic-bezier(0.2, 0.8, 0.2, 1);
    --ease-emph: cubic-bezier(0.16, 1, 0.3, 1);
    --shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 40px rgba(0, 0, 0, 0.06);
    --shadow-dark: 0 28px 80px rgba(0, 0, 0, 0.3);

    position: relative;
    overflow: hidden;
    padding-top: clamp(8.5rem, 12vw, 11rem);
    background: #050505;
    color: var(--t-dark);
    font-family: var(--font);
  }

  /* ---------- Fundo fotográfico + overlay (mesmo tratamento das Heroes das páginas) ---------- */
  .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .scene {
    position: absolute;
    inset: 0;
    opacity: 0;
    will-change: opacity;
    /* ciclo de 18s, 6s por cena; a primeira já nasce visível e as demais entram sobrepostas ao fim da anterior */
    animation: sceneFade 18s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 6s - 1.44s);
  }
  .scene img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
    filter: brightness(1.08) saturate(1.04);
    animation: sceneDrift 18s linear infinite;
    animation-delay: calc(var(--k) * 6s - 1.44s);
  }
  @keyframes sceneFade {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    33.33% {
      opacity: 1;
    }
    41.33%,
    100% {
      opacity: 0;
    }
  }
  /* deslocamento mínimo (escala de 1,05 → 1) enquanto a cena está ativa */
  @keyframes sceneDrift {
    0% {
      transform: scale(1.05);
    }
    41.33%,
    100% {
      transform: scale(1);
    }
  }
  /* esquerda mais escura atrás do texto; do centro à direita as fotos aparecem; base escura para a faixa de tags */
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(5, 6, 10, 0.86) 0%, rgba(5, 6, 10, 0.8) 22%, rgba(5, 6, 10, 0.7) 34%, rgba(5, 6, 10, 0.46) 44%, rgba(5, 6, 10, 0.16) 54%, rgba(5, 6, 10, 0.08) 64%, rgba(5, 6, 10, 0.12) 80%, rgba(5, 6, 10, 0.24) 100%),
      linear-gradient(180deg, rgba(5, 6, 10, 0.5) 0%, rgba(5, 6, 10, 0) 18%, rgba(5, 6, 10, 0) 62%, rgba(5, 5, 5, 0.92) 100%);
  }
  .hero-grid,
  .band {
    position: relative;
    z-index: 1;
  }
  .wrap {
    width: min(100% - 48px, 1360px);
    margin-inline: auto;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  /* ---------- Tipografia (ds3) ---------- */
  .eyebrow {
    margin-bottom: 2rem;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #d0d0d0;
  }
  .display {
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.056em;
    text-wrap: balance;
  }
  .ln {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .ln > span {
    display: block;
  }
  .ln.pb {
    padding-bottom: 0.16em;
  }
  .it {
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.06em;
    font-size: 1.08em;
    line-height: 1.05;
    padding-right: 0.06em;
  }
  .lead {
    margin-top: 2rem;
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--t-dark-2);
  }
  .h3 {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  /* ---------- Botões (ds3) ---------- */
  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }
  .hbtn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding-inline: 28px;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.28s var(--ease-std), background 0.28s var(--ease-std), box-shadow 0.28s var(--ease-std);
  }
  .hbtn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }
  .hbtn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.28s var(--ease-std);
  }
  .hbtn:hover svg {
    transform: translate(2px, -2px);
  }
  .hbtn-lg {
    height: 60px;
    padding-inline: 36px;
    font-size: 1rem;
  }
  .hbtn-primary {
    background: #fff;
    color: #080808;
    border: 1px solid #fff;
  }
  .hbtn-primary:hover {
    background: #ececec;
  }
  .sheen {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    z-index: -1;
    pointer-events: none;
  }
  .sheen::after {
    content: '';
    position: absolute;
    top: 0;
    left: -50%;
    width: 50%;
    height: 100%;
    background: rgba(0, 0, 0, 0.1);
    filter: blur(4px);
    transform: skewX(12deg);
    opacity: 0;
    transition: transform 0.7s, opacity 0.7s;
  }
  .hbtn:hover .sheen::after {
    transform: translateX(320%) skewX(12deg);
    opacity: 0.5;
  }
  .hbtn:focus-visible,
  .hlink:focus-visible {
    outline: 2px solid var(--t-dark);
    outline-offset: 4px;
  }

  /* ação secundária: contêiner circular do ds3 (ícone gira 45° no hover) */
  .hlink {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--t-dark);
    border-radius: 999px;
  }
  .ibtn {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--t-dark);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.5s var(--ease-std), background 0.5s, color 0.5s;
  }
  .ibtn svg {
    width: 18px;
    height: 18px;
  }
  .hlink:hover .ibtn {
    transform: rotate(45deg);
    background: #fff;
    color: #080808;
  }
  .ibtn-d {
    color: var(--t-light);
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--b-dark-s);
  }

  /* ---------- Composição visual (ds3 .hv) ---------- */
  .hv {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 534 / 660;
  }
  .hv-panel {
    position: absolute;
    inset: 15% 0 0;
    border-radius: 56px;
    background: radial-gradient(120% 70% at 50% 0%, rgba(255, 255, 255, 0.06), transparent 60%), rgba(8, 8, 8, 0.5);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    overflow: hidden;
    box-shadow: var(--shadow-dark), inset 0 0 0 1px var(--b-dark);
  }
  .amb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
    animation: heroBreathe 9s ease-in-out infinite alternate;
  }
  .a1 {
    width: 60%;
    height: 45%;
    top: -10%;
    right: -15%;
    background: rgba(var(--glow-a), 0.22);
  }
  .a2 {
    width: 55%;
    height: 40%;
    bottom: 10%;
    left: -20%;
    background: rgba(var(--glow-b), 0.14);
    animation-delay: -4s;
  }
  .hv-3d {
    position: absolute;
    inset: 0;
    perspective: 1400px;
    z-index: 2;
  }
  .hv-ghost {
    position: absolute;
    top: 0;
    left: 12%;
    width: 76%;
    aspect-ratio: 16 / 11;
    border-radius: 16px;
    background: #141416;
    transform: rotate(-6deg);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 20px 50px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }
  .hv-img {
    position: absolute;
    top: 3%;
    left: 5%;
    width: 90%;
    border-radius: 16px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    transform-origin: 50% 100%;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding-inline: 14px;
    background: linear-gradient(#1c1c1e, #141416);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }
  .bar span {
    margin-inline: auto;
    font-size: 0.625rem;
    color: #8a8a8a;
    padding: 3px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
  }

  /* interface ilustrativa no lugar da foto — skeleton do ds3 (.sk) */
  .ui {
    aspect-ratio: 16 / 10;
    display: grid;
    grid-template-columns: 15% 1fr;
    background: radial-gradient(80% 70% at 85% 0%, rgba(var(--glow-a), 0.12), transparent 70%),
      radial-gradient(60% 60% at 0% 100%, rgba(var(--glow-c), 0.1), transparent 70%), #0d0d0e;
  }
  .ui-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }
  .ui-side b {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.1);
  }
  .ui-side b:first-child {
    background: rgba(255, 255, 255, 0.85);
  }
  .ui-main {
    padding: 7% 8% 0;
    display: flex;
    flex-direction: column;
  }
  .sk {
    display: block;
    height: 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
  }
  .sk.e {
    width: 26%;
    height: 5px;
  }
  .sk.h {
    height: clamp(10px, 1.6vw, 15px);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.85);
    margin-top: 8px;
  }
  .sk.e + .sk.h {
    margin-top: 12px;
  }
  .opts {
    list-style: none;
    margin-top: auto;
    margin-bottom: 7%;
    display: grid;
    gap: 6px;
  }
  .opts li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: clamp(0.5625rem, 0.85vw, 0.6875rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    animation: heroPick 9s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 3s);
  }
  .opts i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .opts svg {
    width: 12px;
    height: 12px;
    margin-left: auto;
    opacity: 0;
    animation: heroPickIcon 9s var(--ease-std) infinite;
    animation-delay: calc(var(--k) * 3s);
  }
  @keyframes heroPick {
    0%,
    30% {
      color: #fff;
      background: rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    }
    36%,
    100% {
      color: rgba(255, 255, 255, 0.55);
      background: rgba(255, 255, 255, 0.04);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    }
  }
  @keyframes heroPickIcon {
    0%,
    30% {
      opacity: 1;
    }
    36%,
    100% {
      opacity: 0;
    }
  }

  .hv-cap {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem;
    border-radius: 0 0 56px 56px;
    color: var(--t-light);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
  }
  .cap-sm {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--t-light-2);
  }
  .note {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px 9px 9px;
    border-radius: 14px;
    background: #f5f5f5;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
    transform: rotate(var(--r));
    animation: heroFloat 5s ease-in-out infinite;
    animation-delay: var(--dl);
  }
  .note i {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--black);
    color: #fff;
  }
  .note svg {
    width: 15px;
    height: 15px;
  }
  .note b {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #101010;
    white-space: nowrap;
  }
  .note small {
    display: block;
    font-size: 0.6875rem;
    color: #6b6b6b;
  }
  @keyframes heroFloat {
    50% {
      transform: rotate(var(--r)) translateY(-10px);
    }
  }
  @keyframes heroBreathe {
    to {
      transform: translate3d(-8%, 6%, 0) scale(1.12);
      opacity: 0.7;
    }
  }

  /* ---------- Entrada (ds3) — começa quando a cortina sai ---------- */
  :global(.js) .ln > span {
    transform: translateY(110%);
    transition: transform 0.9s var(--ease-emph) calc(0.2s + var(--i) * 0.09s);
  }
  :global(.js) .fu {
    opacity: 0;
    transform: translateY(24px);
