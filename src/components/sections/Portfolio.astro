---
/**
 * 7.1 CASE REAL — Sítio Hotel: dois mockups de celular (guia digital e cardápio
 * interativo), texto do case e feedbacks reais da gestora (capturas originais).
 * Conteúdo em src/data/home.ts (portfolioCase). O cabeçalho e a fileira de projetos
 * do portfólio vivem em PortfolioV2.astro.
 */
import Icon from '../Icon.astro';
import { portfolioCase as cs } from '../../data/home';
import { whatsappUrl } from '../../data/site';
---

<section class="section pf-sec" id="case-sitio-hotel" data-tone="0" aria-label="Case real: Sítio Hotel">
  <div class="container">
    <div class="feat">
      <div class="vis">
        <div class="feat-frame s-glass bg-grad rv">
          <div class="feat-img clip">
            <span class="amb" aria-hidden="true"></span>
            <div class="feat-par" data-par>
              <div class="slides" data-slides tabindex="0" aria-label="Guia digital, cardápio e feedbacks do Sítio Hotel">
                <div class="slide">
                  {
                    cs.phones.map((ph, k) => (
                      <figure class:list={['phone', k === 0 ? 'p1' : 'p2']}>
                        <img src={ph.src} alt={ph.alt} width={ph.width} height={ph.height} loading="lazy" decoding="async" />
                      </figure>
                    ))
                  }
                </div>
                <div class="slide slide-fb">
                  <h3 class="fb-title">{cs.feedback.title}</h3>
                  <figure class="phone fbp">
                    {cs.feedback.shots.map((f) => <img src={f.src} alt={f.alt} width={f.width} height={f.height} loading="lazy" decoding="async" />)}
                  </figure>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="ctrl" role="group" aria-label="Alternar entre as telas do case">
          <button type="button" class="nav prev" data-slides-prev aria-label="Tela anterior"><Icon name="right" /></button>
          <div class="dots">
            <button type="button" class="dot" data-slides-dot="0" aria-label="Ver guia e cardápio" aria-current="true"></button>
            <button type="button" class="dot" data-slides-dot="1" aria-label="Ver feedbacks"></button>
          </div>
          <button type="button" class="nav next" data-slides-next aria-label="Próxima tela"><Icon name="right" /></button>
        </div>
      </div>
      <div class="case">
        <span class="pill bg-grad rv">{cs.pill}</span>
        <h3 class="h2" data-split>{cs.title} <span class="grad">{cs.accent}</span></h3>
        {cs.text.map((t, k) => <p class="body rv" style={`--d:${0.3 + k * 0.08}s`}>{t}</p>)}
        <dl class="meta rv" style="--d:.5s">
          {
            cs.rows.map((m) => (
              <div>
                <dt>{m.term}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="actions rv" style="--d:.6s">
          <a class="btn btn-glass" href={whatsappUrl ?? '/contato'} target="_blank" rel="noopener" data-mag>
            {cs.cta}
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.vis');
  const row = root?.querySelector<HTMLElement>('[data-slides]');
  if (root && row) {
    const slides = Array.from(row.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-slides-dot]'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0;
    const go = (i: number) => {
      cur = (i + slides.length) % slides.length;
      row.scrollTo({ left: slides[cur].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    };
    row.addEventListener(
      'scroll',
      () => {
        cur = Math.round(row.scrollLeft / row.clientWidth);
        dots.forEach((d, i) => (i === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      },
      { passive: true },
    );
    root.querySelector('[data-slides-prev]')?.addEventListener('click', () => go(cur - 1));
    root.querySelector('[data-slides-next]')?.addEventListener('click', () => go(cur + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    row.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(cur + 1);
      if (e.key === 'ArrowLeft') go(cur - 1);
    });
  }
</script>

<style>
  .pf-sec {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  /* ---------- Destaque (ds2 .feat) ---------- */
  .feat {
    margin-top: clamp(4rem, 8vw, 6.5rem);
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .feat-frame {
    padding: 8px;
    border-radius: 28px;
  }
  .feat-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 22px;
    background: #0b0b0b;
  }
  /* brilho sutil em roxo, no padrão ambiente do site */
  .feat-img .amb {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(60% 55% at 50% 105%, rgba(var(--amb-violet), 0.22), transparent 70%),
      radial-gradient(40% 40% at 85% 0%, rgba(var(--amb-deep), 0.14), transparent 70%);
  }
  .feat-par {
    position: absolute;
    inset: 0;
    --ip: 0;
    transform: scale(calc(1.14 - var(--ip) * 0.14));
  }
  /* carrossel horizontal das telas do case (rolagem lateral com encaixe) */
  .slides {
    position: absolute;
    inset: 0;
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .slides::-webkit-scrollbar {
    display: none;
  }
  .slides:focus-visible {
    outline: 2px solid var(--ring-s);
    outline-offset: -4px;
    border-radius: 22px;
  }
  .slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  /* smartphones: moldura discreta, tela com a proporção original da captura */
  .phone {
    margin: 0;
    padding: 5px;
    border-radius: 26px;
    background: #0a0a0a;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16), 0 30px 60px -20px rgba(0, 0, 0, 0.8);
  }
  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 21px;
  }
  .p1,
  .p2 {
    position: absolute;
    width: 33%;
  }
  .p1 {
    left: 15%;
    top: 9%;
    z-index: 1;
  }
  .p2 {
    left: 50%;
    top: 16%;
    z-index: 2;
  }
  /* tela dos feedbacks: capturas originais empilhadas dentro do celular */
  .slide-fb {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.6vw, 18px);
  }
  .fb-title {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .fbp {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 31%;
    min-width: 0;
    background: #0a0a0a;
  }
  .fbp img {
    border-radius: 12px;
  }
  .ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 20px;
  }
  .dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.25;
    cursor: pointer;
    transition: width 0.5s var(--ease-emphasis), opacity 0.3s;
  }
  .dot:hover {
    opacity: 0.5;
  }
  .dot[aria-current='true'] {
    width: 28px;
    opacity: 0.9;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: inherit;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 1px var(--ring);
    cursor: pointer;
    transition: background 0.3s;
  }
  .nav:hover {
    background: rgba(255, 255, 255, 0.16);
  }
  .nav :global(svg) {
    width: 16px;
    height: 16px;
  }
  .nav.prev :global(svg) {
    transform: rotate(180deg);
  }
  .nav:focus-visible,
  .dot:focus-visible {
    outline: 2px solid var(--ring-s);
    outline-offset: 3px;
  }
  .case .h2 {
    margin-top: 20px;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
  }
  .case .body {
    margin-top: 18px;
  }
  .case .body:first-of-type {
    color: #fff;
  }
  .case .meta div {
    flex-direction: column;
    gap: 4px;
  }
  .case .meta dd {
    text-align: left;
  }
  .case .actions {
    justify-content: flex-start;
    margin-top: 32px;
  }

  @media (max-width: 1000px) {
    .feat {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 640px) {
    .feat-img {
      aspect-ratio: 1 / 1.2;
    }
    .phone {
      padding: 4px;
      border-radius: 20px;
    }
    .phone img {
      border-radius: 16px;
    }
    .p1,
    .p2 {
      width: 43%;
    }
    .p1 {
      left: 5%;
      top: 6%;
    }
    .p2 {
      left: 52%;
      top: 15%;
    }
    .fbp {
      width: 56%;
    }
  }
</style>
