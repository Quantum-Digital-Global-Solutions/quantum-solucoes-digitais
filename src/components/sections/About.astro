---
/**
 * 10. SOBRE A QUANTUM — split do ds2 (moldura glass + texto e metadados).
 * Sem fundadores.
 */
import { about } from '../../data/home';
import { LOGO } from '../../data/site';
---

<section class="section" id="sobre" data-tone="0" aria-labelledby="sobre-title">
  <div class="container split">
    <div class="frame s-glass bg-grad rv">
      <div class="vis">
        <span class="hair"></span>
        <div class="orbs" aria-hidden="true">
          <i style="left:0;background:rgb(var(--amb-deep))"></i>
          <i style="left:34%;background:rgb(var(--amb-blue));animation-delay:-2s"></i>
          <i style="left:68%;background:rgb(var(--amb-orange));animation-delay:-4s"></i>
        </div>
        <img src={LOGO.light} alt={LOGO.alt} width={LOGO.width} height={LOGO.height} loading="lazy" decoding="async" />
      </div>
    </div>
    <div>
      <span class="pill bg-grad rv">{about.pill}</span>
      <h2 class="h2" id="sobre-title" data-split>{about.title}<br /><span class="grad">{about.accent}</span></h2>
      {about.text.map((t, k) => <p class="body rv" style={`--d:${0.3 + k * 0.08}s`}>{t}</p>)}
      <dl class="meta rv" style="--d:.4s">
        {
          about.facts.map((f) => (
            <div>
              <dt>{f.term}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .frame {
    padding: 8px;
    border-radius: 28px;
  }
  .vis {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 11;
    border-radius: 22px;
    background: radial-gradient(60% 50% at 50% 40%, rgba(64, 29, 191, 0.3), transparent 70%), #050505;
    box-shadow: inset 0 0 0 1px var(--ring);
  }
  .vis img {
    filter: invert(1);
    position: relative;
    width: min(66%, 420px);
    height: auto;
  }
  .orbs {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 46%;
    height: 30%;
    translate: -50% 0;
    opacity: 0.55;
  }
  .orbs i {
    position: absolute;
    top: 50%;
    width: 32%;
    aspect-ratio: 1;
    border-radius: 50%;
    translate: 0 -50%;
    filter: blur(28px);
    opacity: 0.7;
    animation: breathe 7s ease-in-out infinite;
  }
  .h2 {
    margin-top: 20px;
    text-wrap: wrap;
  }
  .body {
    margin-top: 18px;
  }
  @media (max-width: 1000px) {
    .split {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
